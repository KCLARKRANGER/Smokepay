# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this app, used in customer payment links.
# Example: https://smokepay.vercel.app
APP_BASE_URL=

# Text messaging (optional). Without these, the counter QR code is used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Protects the session expiry job. Any long random string.
CRON_SECRET=
